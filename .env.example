# Neon Postgres (required for /api/* routes)
DATABASE_URL=

# Paystack (both keys from Paystack → Settings → API Keys; must be same mode: test+test or live+live)
# Frontend build: VITE_PAYSTACK_PUBLIC_KEY=pk_live_... (production matoe.store)
# Vercel server only: PAYSTACK_SECRET_KEY=sk_live_...  (never pk_ or sk_ in the wrong slot)
VITE_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Admin (server only — never prefix with VITE_)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Optional: comma-separated allowed origins for CORS (e.g. https://yourdomain.com,https://www.yourdomain.com)
ALLOWED_ORIGINS=

# Optional frontend config
VITE_SITE_URL=
VITE_ADMIN_PATH=/dev_seyram

# Telegram alerts when a customer places an order (create bot with @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
