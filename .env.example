# Neon Postgres (required for /api/packages and /api/orders)
DATABASE_URL=

# Paystack public key for checkout (pk_test_... or pk_live_...)
VITE_PAYSTACK_PUBLIC_KEY=

# Admin login password (server only — never prefix with VITE_)
ADMIN_PASSWORD=

# Secret for signing admin session cookies (use a long random string, 32+ chars)
ADMIN_SESSION_SECRET=

# Telegram alerts when a customer places an order (create bot with @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
